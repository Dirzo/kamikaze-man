{
  "version": "v7-content-pass-a",
  "root": "/art/v7",
  "goals": [
    "weapon-family-specific hero animation sets",
    "true trimmed transparent sewer enemy frames",
    "layered Disco Sewer scene matching concept rendering",
    "no runtime silhouette masks for production-ready actors"
  ],
  "technicalRules": {
    "sourceScale": "4x minimum",
    "runtimeFormat": "transparent WebP or PNG",
    "framePaddingPx": 4,
    "extrudePx": 2,
    "trimTransparentFrames": true,
    "hitboxesIndependentOfArt": true,
    "runtimeMasking": "fallback-only",
    "anchorsNormalized": true,
    "requiredAnchors": [
      "feet",
      "center",
      "head",
      "hand_primary",
      "hand_support",
      "weapon_socket",
      "fx_origin"
    ]
  },
  "player": {
    "id": "crazy-man",
    "normalDrawHeight": 88,
    "families": {
      "blade": {
        "weaponTypes": ["sword", "katana", "dagger"],
        "atlas": "/art/v7/player/player-crazy-man-blade-atlas-v7.webp",
        "meta": "/art/v7/player/player-crazy-man-blade-atlas-v7.json"
      },
      "heavy": {
        "weaponTypes": ["hammer"],
        "atlas": "/art/v7/player/player-crazy-man-heavy-atlas-v7.webp",
        "meta": "/art/v7/player/player-crazy-man-heavy-atlas-v7.json"
      },
      "ranged": {
        "weaponTypes": ["bow"],
        "atlas": "/art/v7/player/player-crazy-man-ranged-atlas-v7.webp",
        "meta": "/art/v7/player/player-crazy-man-ranged-atlas-v7.json"
      },
      "caster": {
        "weaponTypes": ["wand", "staff"],
        "atlas": "/art/v7/player/player-crazy-man-caster-atlas-v7.webp",
        "meta": "/art/v7/player/player-crazy-man-caster-atlas-v7.json"
      },
      "trick": {
        "weaponTypes": ["shuriken", "nunchucks"],
        "atlas": "/art/v7/player/player-crazy-man-trick-atlas-v7.webp",
        "meta": "/art/v7/player/player-crazy-man-trick-atlas-v7.json"
      }
    },
    "requiredClips": {
      "idle": 4,
      "run": 6,
      "jump_rise": 2,
      "fall": 2,
      "land": 3,
      "attack_a": 6,
      "attack_b": 6,
      "attack_air": 5,
      "skill": 6,
      "hit": 3,
      "death": 6,
      "victory": 5
    },
    "frameContract": {
      "required": ["frame", "sourceSize", "trim", "pivot", "anchors"],
      "attackAnchors": ["weapon_socket", "hand_primary", "hand_support", "fx_origin"],
      "rangedAnchors": ["muzzle"],
      "notes": "Weapon-family pose must be authored into the body silhouette; runtime weapon rendering may still swap weapon art at the socket."
    }
  },
  "sewerEnemies": {
    "crawler": {
      "identity": "Googly",
      "atlas": "/art/v7/enemies/enemy-googly-atlas-v7.webp",
      "meta": "/art/v7/enemies/enemy-googly-atlas-v7.json",
      "clips": {"idle": 5, "move": 5, "attack": 5, "hit": 2, "death": 6}
    },
    "wizard": {
      "identity": "Splorker",
      "atlas": "/art/v7/enemies/enemy-splorker-atlas-v7.webp",
      "meta": "/art/v7/enemies/enemy-splorker-atlas-v7.json",
      "clips": {"idle": 5, "windup": 4, "attack": 6, "hit": 2, "death": 6}
    },
    "shieldbro": {
      "identity": "Blockjaw",
      "atlas": "/art/v7/enemies/enemy-blockjaw-atlas-v7.webp",
      "meta": "/art/v7/enemies/enemy-blockjaw-atlas-v7.json",
      "clips": {"idle": 4, "move": 6, "guard": 4, "attack": 6, "hit": 3, "death": 7}
    },
    "blinker": {
      "identity": "Glitch Intern",
      "atlas": "/art/v7/enemies/enemy-glitch-intern-atlas-v7.webp",
      "meta": "/art/v7/enemies/enemy-glitch-intern-atlas-v7.json",
      "clips": {"idle": 5, "move": 5, "teleport": 5, "attack": 5, "hit": 2, "death": 6}
    },
    "bombchicken": {
      "identity": "Toxic Bomb Chicken",
      "atlas": "/art/v7/enemies/enemy-bomb-chicken-atlas-v7.webp",
      "meta": "/art/v7/enemies/enemy-bomb-chicken-atlas-v7.json",
      "clips": {"idle": 4, "move": 6, "attack": 5, "explode": 7, "hit": 2, "death": 5}
    }
  },
  "enemyFrameContract": {
    "trimTransparentFrames": true,
    "maxTransparentBorderPx": 4,
    "feetAnchorRequiredForGrounded": true,
    "centerAnchorRequiredForAirborne": true,
    "attackFxOriginRequired": true,
    "runtimeClipMask": false,
    "deathMayExceedNormalBounds": true
  },
  "sewerScene": {
    "sceneId": "disco-sewer-of-compliance-v7",
    "canvasReference": [1280, 720],
    "layers": [
      {"id": "far_wall", "asset": "/art/v7/scenes/sewer/sewer-far-wall-v7.webp", "parallax": 0.05, "z": 0},
      {"id": "far_pipes", "asset": "/art/v7/scenes/sewer/sewer-far-pipes-v7.webp", "parallax": 0.10, "z": 10},
      {"id": "drain_arch", "asset": "/art/v7/scenes/sewer/sewer-drain-arch-v7.webp", "parallax": 0.14, "z": 20},
      {"id": "mid_machinery", "asset": "/art/v7/scenes/sewer/sewer-mid-machinery-v7.webp", "parallax": 0.22, "z": 30},
      {"id": "toxic_falls", "asset": "/art/v7/scenes/sewer/sewer-toxic-falls-v7.webp", "parallax": 0.25, "z": 35, "animated": true},
      {"id": "graffiti_signage", "asset": "/art/v7/scenes/sewer/sewer-graffiti-signage-v7.webp", "parallax": 0.24, "z": 38},
      {"id": "platform_skin", "asset": "/art/v7/scenes/sewer/sewer-platform-kit-v7.webp", "parallax": 1.0, "z": 50},
      {"id": "sludge_surface", "asset": "/art/v7/scenes/sewer/sewer-sludge-surface-v7.webp", "parallax": 1.0, "z": 55, "animated": true},
      {"id": "actor_plane", "asset": null, "parallax": 1.0, "z": 60},
      {"id": "foreground_pipes", "asset": "/art/v7/scenes/sewer/sewer-foreground-pipes-v7.webp", "parallax": 1.12, "z": 70},
      {"id": "foreground_chains", "asset": "/art/v7/scenes/sewer/sewer-foreground-chains-v7.webp", "parallax": 1.18, "z": 75, "animated": true},
      {"id": "atmosphere", "asset": "/art/v7/scenes/sewer/sewer-atmosphere-v7.webp", "parallax": 1.0, "z": 80, "animated": true}
    ],
    "lighting": {
      "ambient": "cool blue-gray",
      "sludgeBounce": "acid green from below",
      "practicals": ["cyan", "magenta"],
      "actorPriority": "player and hostile telegraphs remain brighter than background",
      "weaponLightCanAffectScene": true
    },
    "platformStyle": {
      "outline": "dark colored, not pure black",
      "hazardStripe": true,
      "paintedShade": true,
      "grime": "subtle",
      "slimeDrips": "selective"
    }
  },
  "acceptance": {
    "player": [
      "weapon family visibly changes body pose",
      "weapon socket stays inside hand through full attack",
      "no default green basic attack strike",
      "no rectangular frame edge or mask clipping"
    ],
    "enemies": [
      "no visible rectangular crop",
      "no generic oval clipping",
      "attack and death frames may extend beyond idle bounds",
      "grounded enemies sit on floor using feet anchor"
    ],
    "scene": [
      "reads as the approved illustrated sewer concept at gameplay distance",
      "minimum four visually distinct depth planes",
      "platforms feel authored into environment rather than prototype geometry",
      "foreground never blocks core combat readability"
    ]
  }
}
