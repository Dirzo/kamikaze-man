{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crazy-weapon-man",
  "main": "crazy-weapon-man-site/src/index.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./crazy-weapon-man-site/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "observability": {
    "enabled": true
  }
}
